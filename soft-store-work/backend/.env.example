DATABASE_URL=postgres://user:pass@host:5432/db
ADMIN_KEY=change-me

# Comma-separated. Every bot must be an ADMIN of every channel below.
TELEGRAM_BOT_TOKENS=111111:AAA...,222222:BBB...,333333:CCC...
# Private channel ids (start with -100...). More channels = more headroom.
TELEGRAM_CHAT_IDS=-1001111111111,-1002222222222

# optional
MAX_UPLOAD_MB=500
UPLOAD_PARALLEL=3
MAX_IMAGE_MB=5
# Public URL of this API, used to build icon/download links (auto-detected if unset)
PUBLIC_URL=https://your-api.onrender.com
