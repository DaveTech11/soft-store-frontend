# ---- runtime (backend) ----
DATABASE_URL=postgres://user:pass@host:5432/db
ADMIN_KEY=change-me
TELEGRAM_BOT_TOKENS=111111:AAA...,222222:BBB...
TELEGRAM_CHAT_IDS=-1001111111111,-1002222222222
PUBLIC_URL=https://your-domain.com
# MAX_UPLOAD_MB=500
# MAX_IMAGE_MB=5

# ---- build time (frontend) ----
# Must equal ADMIN_KEY for the Admin page to save. NOTE: it is baked into the public JS bundle.
VITE_ADMIN_KEY=change-me
